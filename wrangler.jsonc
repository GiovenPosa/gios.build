// Cloudflare Worker that serves the site: the built files in dist/, with the
// small script in worker/ in front of them. It redirects other addresses to
// https://www.gios.build, and answers /stats (the Umami pass-through) and
// /api (the enquiry form's endpoint).
//
// The enquiry endpoint also needs the Supabase secret key, kept out of this
// file and out of the browser: `npx wrangler secret put SUPABASE_SECRET_KEY`.
// For local testing, put it in .dev.vars (gitignored) and run
// `npm run build && npx wrangler dev`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gios-build",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // any path without a file gets index.html; the router shows the page, or
    // the not-found page (the Worker gives that one a 404 status)
    "not_found_handling": "single-page-application",
    // every request goes through the Worker first, for the redirect to
    // https://www.gios.build and the 404s (worker/index.ts)
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://tbewrjkilpnifzzygqhv.supabase.co",
    // website audits a day across the site before new ones are held
    // (worker/audit.ts). The audit's Turnstile secret is a secret:
    // `npx wrangler secret put TURNSTILE_SECRET`
    "AUDIT_DAILY_CAP": "50",
    // the audit's Google Business Profile check (worker/audit/places.ts):
    // on since Places billing was set up, 14 Nov 2026
    "AUDIT_PLACES": "true",
    // the model that writes the audit reports (worker/audit/write.ts). The
    // Claude key is a secret: `npx wrangler secret put ANTHROPIC_API_KEY`
    "AUDIT_MODEL": "claude-sonnet-5-5"
  },
  // enquiry form requests per visitor IP: generous for a person going back
  // and forth between steps, tight for a script
  "ratelimits": [
    { "name": "ENQUIRY_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // the audit form: a couple of tries a minute (worker/audit.ts adds three a day)
    { "name": "AUDIT_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // the website audit's background run: gathers each request's facts
  // (worker/auditWorkflow.ts). Its Google key is a secret:
  // `npx wrangler secret put GOOGLE_API_KEY`
  "workflows": [
    { "name": "gios-build-audit", "binding": "AUDIT_WORKFLOW", "class_name": "AuditWorkflow" }
  ],
  "observability": { "enabled": true }
}
